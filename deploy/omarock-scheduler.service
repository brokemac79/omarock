[Unit]
Description=OmaRock guarded scheduled cleaning
[Service]
Type=oneshot
WorkingDirectory=%h/.config/omarchy/plugins/io.github.brokemac79.omarock
ExecStart=%h/.local/share/omarock/venv/bin/python %h/.config/omarchy/plugins/io.github.brokemac79.omarock/omarock.py scheduler-tick
UMask=0077
TimeoutStartSec=50
